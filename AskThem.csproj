<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AskThem</AssemblyName>
    <RootNamespace>AskThem</RootNamespace>
    <!-- Version affichée dans le titre et comparée aux publications GitHub. -->
    <Version>1.3.3</Version>
    <AssemblyVersion>1.3.3.0</AssemblyVersion>
    <FileVersion>1.3.3.0</FileVersion>
    <Company>Lyncée Tec SA</Company>
    <Product>AskThem</Product>
    <Description>Préparation des demandes d'offre et de fabrication depuis le coffre SolidWorks PDM.</Description>
    <ApplicationIcon>assets\askthem.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableComHosting>false</EnableComHosting>
    <!-- Portabilite : tout est empaquete dans un unique .exe, executable depuis
         n'importe quel dossier et sur un poste sans .NET installe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Sortie a plat dans AskThem\dist\ au lieu de bin\Release\net8.0-windows\win-x64\publish\ -->
    <PublishDir>$(MSBuildProjectDirectory)\dist\</PublishDir>
  </PropertyGroup>
  <!-- Les interops SolidWorks sont embarquées dans lib/ pour que la compilation
       fonctionne partout, y compris en intégration continue. Leur redistribution
       est autorisée par redist.txt. À défaut, on retombe sur l'installation locale. -->
  <PropertyGroup>
    <SwRedist>$(MSBuildProjectDirectory)\lib</SwRedist>
    <SwRedist Condition="!Exists('$(SwRedist)\SolidWorks.Interop.sldworks.dll')">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SwRedist>
  </PropertyGroup>
  <!-- L'icone est embarquee : la fenetre la charge depuis l'assembly, sans dependre
       de l'extraction des ressources de l'executable. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\askthem.ico" />
  </ItemGroup>
  <!-- Reglages du rapport de controle : deposes a cote de l'executable, modifiables
       sur un poste sans recompiler. Recrees avec leurs valeurs par defaut s'ils manquent. -->
  <ItemGroup>
    <None Update="Config\rapport-controle.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>config\rapport-controle.json</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwRedist)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>True</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwRedist)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
  </ItemGroup>
</Project>
