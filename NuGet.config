<?xml version="1.0" encoding="utf-8"?>
<!-- Source NuGet limitee a ce projet : n'affecte pas la configuration globale du poste.
     Necessaire uniquement pour la publication auto-contenue (runtime packs win-x64).
     Supprimer ce fichier suffit a revenir a l'etat initial. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
